{
  "kind": "Template",
  "apiVersion": "template.openshift.io/v1",
  "metadata": {
    "name": "podescape-io",
    "annotations": {
      "openshift.io/display-name": "PodEscape static site (Apache httpd)",
      "description": "Serves the PodEscape WebAssembly build with Red Hat's Hummingbird httpd image. Builds the repository Dockerfile inside the cluster.",
      "tags": "quickstart,httpd,static",
      "iconClass": "icon-apache",
      "openshift.io/long-description": "Creates a Docker-strategy BuildConfig that builds this repository's Dockerfile, an output ImageStream, a Deployment, a Service and a Route. There is no s2i build step; the image is based on registry.access.redhat.com/hi/httpd and runs as a non-root user on port 8080.",
      "openshift.io/provider-display-name": "CodeCafe OpenShift Game team",
      "openshift.io/documentation-url": "https://github.com/CodeCafeOpenShiftGame/podescape.io",
      "openshift.io/support-url": "https://github.com/CodeCafeOpenShiftGame/PodEscape",
      "template.openshift.io/bindable": "false"
    }
  },
  "message": "The following objects have been created: ${NAME} (BuildConfig, ImageStream, Deployment, Service, Route).\n\nStart the first build with:\n  oc start-build ${NAME} --follow\n\nThe build pulls ${SOURCE_REPOSITORY_URL} from GitHub and builds the repository Dockerfile. The Deployment rolls out automatically when the ${NAME}:latest ImageStreamTag is updated.",
  "labels": {
    "template": "podescape-io",
    "app": "podescape-io"
  },
  "objects": [
    {
      "kind": "ImageStream",
      "apiVersion": "image.openshift.io/v1",
      "metadata": {
        "name": "${NAME}",
        "annotations": {
          "description": "Tracks images built from this repository"
        }
      }
    },
    {
      "kind": "BuildConfig",
      "apiVersion": "build.openshift.io/v1",
      "metadata": {
        "name": "${NAME}",
        "annotations": {
          "description": "Builds the static site image from the repository Dockerfile (no s2i)"
        }
      },
      "spec": {
        "source": {
          "type": "Git",
          "git": {
            "uri": "${SOURCE_REPOSITORY_URL}",
            "ref": "${SOURCE_REPOSITORY_REF}"
          },
          "contextDir": "${CONTEXT_DIR}"
        },
        "strategy": {
          "type": "Docker",
          "dockerStrategy": {
            "dockerfilePath": "Dockerfile"
          }
        },
        "output": {
          "to": {
            "kind": "ImageStreamTag",
            "name": "${NAME}:latest"
          }
        },
        "runPolicy": "SerialLatestOnly",
        "triggers": [
          {
            "type": "GitHub",
            "github": {
              "secret": "${GITHUB_WEBHOOK_SECRET}"
            }
          },
          {
            "type": "Generic",
            "generic": {
              "secret": "${GENERIC_WEBHOOK_SECRET}"
            }
          },
          {
            "type": "ConfigChange"
          }
        ]
      }
    },
    {
      "kind": "Deployment",
      "apiVersion": "apps/v1",
      "metadata": {
        "name": "${NAME}",
        "labels": {
          "app": "${NAME}"
        },
        "annotations": {
          "description": "Serves the static site on port 8080",
          "image.openshift.io/triggers": "[{\"from\":{\"kind\":\"ImageStreamTag\",\"name\":\"${NAME}:latest\"},\"fieldPath\":\"spec.template.spec.containers[0].image\"}]"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "${NAME}"
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxUnavailable": 0,
            "maxSurge": 1
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "${NAME}"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "podescape-io",
                "image": "${NAME}:latest",
                "imagePullPolicy": "Always",
                "ports": [
                  {
                    "name": "web",
                    "containerPort": 8080,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": "web"
                  },
                  "initialDelaySeconds": 3,
                  "timeoutSeconds": 3,
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": "web"
                  },
                  "initialDelaySeconds": 10,
                  "timeoutSeconds": 3,
                  "periodSeconds": 20
                },
                "resources": {
                  "limits": {
                    "memory": "${MEMORY_LIMIT}"
                  },
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "runAsNonRoot": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "kind": "Service",
      "apiVersion": "v1",
      "metadata": {
        "name": "${NAME}",
        "annotations": {
          "description": "Exposes and load balances the application pods"
        }
      },
      "spec": {
        "selector": {
          "app": "${NAME}"
        },
        "ports": [
          {
            "name": "web",
            "port": 8080,
            "targetPort": "web"
          }
        ]
      }
    },
    {
      "kind": "Route",
      "apiVersion": "route.openshift.io/v1",
      "metadata": {
        "name": "${NAME}"
      },
      "spec": {
        "host": "${APPLICATION_DOMAIN}",
        "to": {
          "kind": "Service",
          "name": "${NAME}"
        },
        "port": {
          "targetPort": "web"
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "NAME",
      "displayName": "Name",
      "description": "The name assigned to all of the objects defined in this template.",
      "required": true,
      "value": "podescape-io"
    },
    {
      "name": "MEMORY_LIMIT",
      "displayName": "Memory Limit",
      "description": "Maximum amount of memory the container can use.",
      "required": true,
      "value": "512Mi"
    },
    {
      "name": "SOURCE_REPOSITORY_URL",
      "displayName": "Git Repository URL",
      "description": "The URL of the repository with the application source code.",
      "required": true,
      "value": "https://github.com/CodeCafeOpenShiftGame/podescape.io.git"
    },
    {
      "name": "SOURCE_REPOSITORY_REF",
      "displayName": "Git Reference",
      "description": "Branch, tag or commit to build. Leave empty to build the repository default branch.",
      "required": false,
      "value": ""
    },
    {
      "name": "CONTEXT_DIR",
      "displayName": "Context Directory",
      "description": "Relative path to the build context if it is not the repository root.",
      "required": false,
      "value": ""
    },
    {
      "name": "APPLICATION_DOMAIN",
      "displayName": "Application Hostname",
      "description": "The exposed hostname that will route to the service. Leave empty to have one generated.",
      "required": false,
      "value": ""
    },
    {
      "name": "GITHUB_WEBHOOK_SECRET",
      "displayName": "GitHub Webhook Secret",
      "description": "Secret for the GitHub webhook trigger. A difficult to guess string encoded as part of the webhook URL. Not encrypted.",
      "generate": "expression",
      "from": "[a-zA-Z0-9]{40}"
    },
    {
      "name": "GENERIC_WEBHOOK_SECRET",
      "displayName": "Generic Webhook Secret",
      "description": "A secret string used to configure the Generic webhook.",
      "generate": "expression",
      "from": "[a-zA-Z0-9]{40}"
    }
  ]
}
